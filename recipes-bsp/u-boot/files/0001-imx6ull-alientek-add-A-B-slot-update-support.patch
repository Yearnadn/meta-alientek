From 507dd050888aef29ba90b6697d65add85c9451d3 Mon Sep 17 00:00:00 2001
From: lizhuo <1349952851@qq.com>
Date: Sun, 11 Oct 2026 11:53:18 +0800
Subject: [PATCH] imx6ull: alientek: add A/B slot update support

Signed-off-by: lizhuo <1349952851@qq.com>
---
 configs/imx6ull_alientek_defconfig |  2 ++
 include/configs/imx6ull_alientek.h | 45 +++++++++++++++++++-----------
 2 files changed, 30 insertions(+), 17 deletions(-)

diff --git a/configs/imx6ull_alientek_defconfig b/configs/imx6ull_alientek_defconfig
index 654cdc92dc..5e8643832a 100644
--- a/configs/imx6ull_alientek_defconfig
+++ b/configs/imx6ull_alientek_defconfig
@@ -69,6 +69,8 @@ CONFIG_CONSOLE_MUX=y
 CONFIG_OF_LIBFDT=y
 CONFIG_OF_SEPARATE=y
 CONFIG_LMB=y
+CONFIG_BOOTCOUNT_LIMIT=y
+CONFIG_BOOTCOUNT_ENV=y
 # CONFIG_NET is not set
 # CONFIG_CMD_NET is not set
 # CONFIG_DM_ETH is not set
diff --git a/include/configs/imx6ull_alientek.h b/include/configs/imx6ull_alientek.h
index d03e334aaa..940c245957 100644
--- a/include/configs/imx6ull_alientek.h
+++ b/include/configs/imx6ull_alientek.h
@@ -32,20 +32,15 @@
 	"console=ttymxc0\0" \
 	"fdt_high=0xffffffff\0" \
 	"initrd_high=0xffffffff\0" \
-	"fdt_file=undefined\0" \
+	"fdt_file=imx6ull-alientek.dtb\0" \
 	"fdt_addr=0x83000000\0" \
 	"boot_fdt=try\0" \
 	"videomode=video=ctfb:x:480,y:272,depth:24,pclk:108695,le:8,ri:4,up:2,lo:4,hs:41,vs:10,sync:0,vmode:0\0" \
 	"mmcdev="__stringify(CONFIG_SYS_MMC_ENV_DEV)"\0" \
 	"mmcpart=1\0" \
-	"mmcroot=/dev/mmcblk1p2 rootwait rw\0" \
-	"mmcautodetect=yes\0" \
+	"mmcroot=/dev/mmcblk0p3 rootwait rw\0" \
 	"mmcargs=setenv bootargs console=${console},${baudrate} " \
 		"root=${mmcroot}\0" \
-	"loadbootscript=" \
-		"fatload mmc ${mmcdev}:${mmcpart} ${loadaddr} ${script};\0" \
-	"bootscript=echo Running bootscript from mmc ...; " \
-		"source\0" \
 	"loadimage=fatload mmc ${mmcdev}:${mmcpart} ${loadaddr} ${image}\0" \
 	"loadfdt=fatload mmc ${mmcdev}:${mmcpart} ${fdt_addr} ${fdt_file}\0" \
 	"mmcboot=echo Booting from mmc ...; " \
@@ -63,16 +58,32 @@
 		"else " \
 			"bootz; " \
 		"fi;\0" \
-		"findfdt="\
-			"if test $fdt_file = undefined; then " \
-				"if test $board_name = ULZ-EVK && test $board_rev = 14X14; then " \
-					"setenv fdt_file imx6ulz-14x14-evk.dtb; fi; " \
-				"if test $board_name = EVK && test $board_rev = 14X14; then " \
-					"setenv fdt_file imx6ull-14x14-evk.dtb; fi; " \
-				"if test $fdt_file = undefined; then " \
-					"echo WARNING: Could not determine dtb to use; " \
-				"fi; " \
-			"fi;\0" 
+	"boot_slot=a\0" \
+	"bootcount=0\0" \
+	"bootlimit=3\0" \
+	"upgrade_available=0\0" \
+	"load_kernel=" \
+		"if test \"${boot_slot}\" = \"a\"; then " \
+			"setenv mmcpart 1; " \
+			"setenv mmcroot /dev/mmcblk0p3 rootwait rw; " \
+		"else " \
+			"setenv mmcpart 2; " \
+			"setenv mmcroot /dev/mmcblk0p3 rootwait rw; " \
+		"fi; " \
+		"run loadimage; " \
+		"run loadfdt; " \
+		"run mmcargs; " \
+		"bootz ${loadaddr} - ${fdt_addr}\0" \
+	"altbootcmd=" \
+		"if test \"${boot_slot}\" = \"a\"; then " \
+			"setenv boot_slot b; " \
+		"else " \
+			"setenv boot_slot a; " \
+		"fi; " \
+		"setenv bootcount 0; " \
+		"saveenv; " \
+		"run load_kernel\0" \
+	"bootcmd=run load_kernel\0"
 
 /* Miscellaneous configurable options */
 
-- 
2.34.1

