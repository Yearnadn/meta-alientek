From fd01767b4bd0008472282478ce2df079df73cadf Mon Sep 17 00:00:00 2001
From: lizhuo <1349952851@qq.com>
Date: Fri, 25 Sep 2026 13:00:26 +0800
Subject: [PATCH] mx6ull_atom: Disable network support to reduce U-Boot size
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Remove Ethernet and network stack configuration from
imx6ull_atomboard_defconfig. This is based on NXP's reference
U-Boot for 正点原子 i.MX6ULL platform.

Network functionality is unnecessary for the current production
use case, so disabling it helps minimize the bootloader footprint
and boot latency.
---
 arch/arm/dts/imx6ull_alientek.dts  |  8 ++++++++
 configs/imx6ull_alientek_defconfig | 26 ++++++++++++++------------
 include/configs/imx6ull_alientek.h | 27 +--------------------------
 3 files changed, 23 insertions(+), 38 deletions(-)

diff --git a/arch/arm/dts/imx6ull_alientek.dts b/arch/arm/dts/imx6ull_alientek.dts
index 2723e9163f..ef1196be57 100644
--- a/arch/arm/dts/imx6ull_alientek.dts
+++ b/arch/arm/dts/imx6ull_alientek.dts
@@ -57,4 +57,12 @@
 &backlight_display {
 	status = "okay";
 	enable-gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;
+};
+
+&fec1 {
+    status = "disabled";
+};
+
+&fec2 {
+    status = "disabled";
 };
\ No newline at end of file
diff --git a/configs/imx6ull_alientek_defconfig b/configs/imx6ull_alientek_defconfig
index b17d517765..5ef4dc50b4 100644
--- a/configs/imx6ull_alientek_defconfig
+++ b/configs/imx6ull_alientek_defconfig
@@ -13,7 +13,7 @@ CONFIG_SYS_MEMTEST_START=0x80000000
 CONFIG_SYS_MEMTEST_END=0x88000000
 CONFIG_SUPPORT_RAW_INITRD=y
 CONFIG_USE_BOOTCOMMAND=y
-CONFIG_BOOTCOMMAND="run findfdt;mmc dev ${mmcdev};mmc dev ${mmcdev}; if mmc rescan; then if run loadbootscript; then run bootscript; else if run loadimage; then run mmcboot; else run netboot; fi; fi; else run netboot; fi"
+CONFIG_BOOTCOMMAND="run findfdt; mmc dev ${mmcdev}; mmc rescan; run loadimage; run mmcboot"
 CONFIG_BOARD_EARLY_INIT_F=y
 CONFIG_HUSH_PARSER=y
 CONFIG_SYS_MAXARGS=32
@@ -23,8 +23,6 @@ CONFIG_CMD_MEMTEST=y
 CONFIG_CMD_GPIO=y
 CONFIG_CMD_I2C=y
 CONFIG_CMD_MMC=y
-CONFIG_CMD_DHCP=y
-CONFIG_CMD_PING=y
 CONFIG_CMD_CACHE=y
 CONFIG_CMD_EXT2=y
 CONFIG_CMD_EXT4=y
@@ -37,8 +35,6 @@ CONFIG_ENV_IS_IN_MMC=y
 CONFIG_SYS_RELOC_GD_ENV_ADDR=y
 CONFIG_SYS_MMC_ENV_DEV=1
 CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG=y
-CONFIG_USE_ETHPRIME=y
-CONFIG_ETHPRIME="eth1"
 CONFIG_BOUNCE_BUFFER=y
 CONFIG_DM_74X164=y
 CONFIG_DM_I2C=y
@@ -48,12 +44,6 @@ CONFIG_MTD=y
 CONFIG_DM_SPI_FLASH=y
 CONFIG_SF_DEFAULT_SPEED=40000000
 CONFIG_SPI_FLASH_STMICRO=y
-CONFIG_PHYLIB=y
-CONFIG_PHY_MICREL=y
-CONFIG_PHY_MICREL_KSZ8XXX=y
-CONFIG_DM_ETH_PHY=y
-CONFIG_FEC_MXC=y
-CONFIG_MII=y
 CONFIG_PINCTRL=y
 CONFIG_PINCTRL_IMX6=y
 CONFIG_DM_REGULATOR=y
@@ -75,4 +65,16 @@ CONFIG_VIDEO_LOGO=y
 CONFIG_BMP=y
 CONFIG_CMD_BMP=y
 CONFIG_VIDEO_BMP_LOGO=y
-CONFIG_CONSOLE_MUX=y
\ No newline at end of file
+CONFIG_CONSOLE_MUX=y
+CONFIG_OF_LIBFDT=y
+CONFIG_OF_SEPARATE=y
+CONFIG_LMB=y
+# CONFIG_NET is not set
+# CONFIG_CMD_NET is not set
+# CONFIG_DM_ETH is not set
+# CONFIG_FEC_MXC is not set
+# CONFIG_PHYLIB is not set
+# CONFIG_CMD_MII is not set
+# CONFIG_CMD_DHCP is not set
+# CONFIG_CMD_PING is not set
+# CONFIG_NET_RANDOM_ETHADDR is not set
\ No newline at end of file
diff --git a/include/configs/imx6ull_alientek.h b/include/configs/imx6ull_alientek.h
index 85f5326bbe..d03e334aaa 100644
--- a/include/configs/imx6ull_alientek.h
+++ b/include/configs/imx6ull_alientek.h
@@ -35,7 +35,6 @@
 	"fdt_file=undefined\0" \
 	"fdt_addr=0x83000000\0" \
 	"boot_fdt=try\0" \
-	"ip_dyn=yes\0" \
 	"videomode=video=ctfb:x:480,y:272,depth:24,pclk:108695,le:8,ri:4,up:2,lo:4,hs:41,vs:10,sync:0,vmode:0\0" \
 	"mmcdev="__stringify(CONFIG_SYS_MMC_ENV_DEV)"\0" \
 	"mmcpart=1\0" \
@@ -73,31 +72,7 @@
 				"if test $fdt_file = undefined; then " \
 					"echo WARNING: Could not determine dtb to use; " \
 				"fi; " \
-			"fi;\0" \
-	"netargs=setenv bootargs console=${console},${baudrate} " \
-		"root=/dev/nfs " \
-	"ip=dhcp nfsroot=${serverip}:${nfsroot},v3,tcp\0" \
-		"netboot=echo Booting from net ...; " \
-		"run netargs; " \
-		"if test ${ip_dyn} = yes; then " \
-			"setenv get_cmd dhcp; " \
-		"else " \
-			"setenv get_cmd tftp; " \
-		"fi; " \
-		"${get_cmd} ${image}; " \
-		"if test ${boot_fdt} = yes || test ${boot_fdt} = try; then " \
-			"if ${get_cmd} ${fdt_addr} ${fdt_file}; then " \
-				"bootz ${loadaddr} - ${fdt_addr}; " \
-			"else " \
-				"if test ${boot_fdt} = try; then " \
-					"bootz; " \
-				"else " \
-					"echo WARN: Cannot load the DT; " \
-				"fi; " \
-			"fi; " \
-		"else " \
-			"bootz; " \
-		"fi;\0" \
+			"fi;\0" 
 
 /* Miscellaneous configurable options */
 
-- 
2.34.1

