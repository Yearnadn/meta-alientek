/dts-v1/;

#include "imx6ull.dtsi"
#include "imx6ull-alientek.dtsi"

/ {
	model = "Freescale i.MX6ULL ALIENTEK Board";
	compatible = "alientek,imx6ull", "fsl,imx6ull";
};

&clks {
	assigned-clocks = <&clks IMX6UL_CLK_PLL3_PFD2>;
	assigned-clock-rates = <320000000>;
};

